# Use only the project's publishable/anon key here. Never use service_role/secret keys.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
# Development builds only; production builds remain disabled regardless of this value.
EXPO_PUBLIC_ENABLE_MOCK_PAYMENTS=false
