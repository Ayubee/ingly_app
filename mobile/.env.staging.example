# Copy to mobile/.env.staging.local; replace all YOUR_* placeholders.
# Same staging project and PUBLIC key as admin/.env.staging.local. No server secrets.
EXPO_PUBLIC_APP_ENV=staging
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PROJECT_REF=YOUR_STAGING_PROJECT_REF
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_STAGING_PUBLIC_KEY
EXPO_PUBLIC_ALLOW_LOCAL_HTTP=false
# Optional true for the dev-only local TEST/MOCK simulator; release exports keep it disabled.
EXPO_PUBLIC_ENABLE_MOCK_PAYMENTS=false
