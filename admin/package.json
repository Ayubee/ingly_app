{
  "name": "ingly-admin",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:production": "vite --mode production",
    "verify:auth:production": "node ../scripts/auth-backend-check.cjs production",
    "build:production:checked": "npm run verify:auth:production && npm run build -- --mode production",
    "build": "node scripts/build-real-data.cjs && vite build",
    "build:staging": "npm run build -- --mode staging",
    "verify:staging": "node ../scripts/staging-readiness.cjs verify",
    "build:staging:checked": "node ../scripts/staging-readiness.cjs admin-build",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  }
}
