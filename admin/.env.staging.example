# Copy to admin/.env.staging.local; replace all YOUR_* placeholders.
# Same staging project and PUBLIC key as mobile/.env.staging.local. No server secrets.
APP_ENV=staging
SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
SUPABASE_PROJECT_REF=YOUR_STAGING_PROJECT_REF
SUPABASE_PUBLISHABLE_KEY=YOUR_STAGING_PUBLIC_KEY
ALLOW_LOCAL_HTTP=false
