# Admin: configure explicitly; npm run dev uses development mode.
APP_ENV=development
SUPABASE_URL=https://YOUR-DEVELOPMENT-PROJECT.supabase.co
SUPABASE_PROJECT_REF=YOUR_DEVELOPMENT_PROJECT_REF
SUPABASE_PUBLISHABLE_KEY=YOUR_DEVELOPMENT_PUBLIC_KEY
ALLOW_LOCAL_HTTP=false
# Never put service-role keys, passwords or signing secrets here.
